# SPDX-License-Identifier: Apache-2.0
#
# Device properties for Google Glass Explorer Edition.
# Written from docs/hardware-facts.md.

# Display and graphics
ro.sf.lcd_density=240
ro.opengles.version=131072
ro.bq.gpu_to_cpu_unsupported=1
com.ti.omap_enhancement=true
persist.sys.forced_orientation=0

# HWUI caches, sized for the small display
ro.hwui.disable_scissor_opt=true
ro.hwui.drop_shadow_cache_size=1
ro.hwui.gradient_cache_size=0.5
ro.hwui.layer_cache_size=4
ro.hwui.patch_cache_size=64
ro.hwui.path_cache_size=1
ro.hwui.r_buffer_cache_size=1
ro.hwui.shape_cache_size=0.5
ro.hwui.text_large_cache_height=512
ro.hwui.text_large_cache_width=2048
ro.hwui.text_small_cache_height=256
ro.hwui.text_small_cache_width=1024
ro.hwui.texture_cache_flushrate=0.4
ro.hwui.texture_cache_size=12

# Video encoder
video.h264enc.profile=1

# Wi-Fi
ro.carrier=wifi-only
wifi.interface=wlan0
wifi.supplicant_scan_interval=60
wlan.driver.vendor=bcm

# Bluetooth
bluetooth.enable_timeout_ms=10000
ro.bt.bdaddr_path=/data/misc/bluedroid/bdaddr

# dex2oat on the device: installd (frameworks/native cmds/installd/commands.cpp, 6.0.1) passes
# --compiler-filter=$(dalvik.vm.dex2oat-filter) when it compiles an app installed or updated on
# the Glass; without it dex2oat uses "speed" (art compiler/driver/compiler_options.h). "space"
# keeps such apps' compiled code smaller, so less of it is mapped in the 682 MB of RAM, and
# installs faster. The system and its boot image are compiled at build time (WITH_DEXPREOPT in
# BoardConfig.mk) with the default, speed. "interpret-only" would save more but cost CPU (heat).
dalvik.vm.dex2oat-filter=space
