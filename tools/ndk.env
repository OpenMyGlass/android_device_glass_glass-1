# SPDX-License-Identifier: Apache-2.0
# NDK for the HAL CI (tools/fetch-ndk.sh). r25c is the newest NDK whose minimum API level
# is 19 (Android 4.4); later ones start at 21. The SHA-1 is the one Google publishes in
# https://dl.google.com/android/repository/repository2-3.xml; the SHA-256 was computed
# from the same download, whose SHA-1 matched.
NDK_VERSION=r25c
NDK_URL=https://dl.google.com/android/repository/android-ndk-r25c-linux.zip
NDK_SIZE=531118193
NDK_SHA1=53af80a1cce9144025b81c78c8cd556bff42bd0e
NDK_SHA256=769ee342ea75f80619d985c2da990c48b3d8eaf45f48783a2d48870d04b46108
